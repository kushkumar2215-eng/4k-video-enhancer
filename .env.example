# GEMINI_API_KEY: Optional AI Studio runtime variable (not used as a video super-resolution engine).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ============================================================================
# FREE 4K VIDEO ENHANCER — SERVER & WORKER CONFIGURATION
# ============================================================================

# Secret used to sign short-lived HMAC-SHA256 job & download authorization tokens.
# Keep exclusively on the server. A cryptographic random secret is generated if unset.
JOB_TOKEN_SECRET="replace-with-64-char-random-hex-secret-in-production"

# Remote GPU Worker URL running Real-ESRGAN (e.g., https://gpu-worker.internal:8080)
# Leave empty if no remote GPU worker is deployed yet.
REAL_ESRGAN_WORKER_URL=""

# Shared secret for authenticating requests between the Node.js API and the GPU worker.
WORKER_SHARED_SECRET="replace-with-worker-hmac-secret"

# Optional path to local realesrgan-ncnn-vulkan executable if running on a GPU host.
REAL_ESRGAN_BIN_PATH=""

# Default AI Super-Resolution model name for Real-ESRGAN worker
# Supported: realesr-animevideov3 (fast video model), realesrgan-x4plus (photorealistic)
REAL_ESRGAN_MODEL="realesr-animevideov3"

# Whether to offer the compatible local FFmpeg optical pipeline fallback when no GPU worker is configured.
ALLOW_FFMPEG_FALLBACK="true"

# Configurable resource & quota limits
MAX_UPLOAD_MB="80"
MAX_VIDEO_DURATION_SEC="60"
MAX_CONCURRENT_JOBS="2"
JOB_TIMEOUT_SEC="300"
TWO_MINUTE_TARGET_SEC="120"
RETENTION_MINUTES="30"
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW="20"
RATE_LIMIT_WINDOW_SEC="600"

# Private temporary storage directory (outside public web root)
PRIVATE_STORAGE_DIR="/tmp/free-4k-video-enhancer"
